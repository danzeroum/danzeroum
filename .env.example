# Configuração do formulário de contato (lido pelo container danzeroum-php).
# Copie para .env e preencha a senha real:  cp .env.example .env
# O .env real NÃO vai para o git (está no .gitignore).

# Destino dos contatos
MAIL_TO=contato@danzeroum.com

# SMTP do e-mail do domínio (Hostinger: smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl            # ssl (porta 465) ou tls (porta 587)
SMTP_USER=contato@danzeroum.com
SMTP_PASS=COLOQUE_A_SENHA_AQUI
SMTP_FROM=contato@danzeroum.com
SMTP_FROM_NAME=Site Danzeroum

# --- Autenticação do painel (api/) ---
# Gere o hash com: python scripts/hash_password.py
AUTH_USERNAME=dan@danzeroum.com
AUTH_PASSWORD_HASH=<bcrypt hash gerado pelo script>
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=<random 32+ bytes hex>
SESSION_TTL_HOURS=8
