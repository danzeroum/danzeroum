# Configuração do rastreador (copie para .env). Sem segredos obrigatórios na V1.

# Banco (Docker liga db:5432 automaticamente — ajuste só se usar Postgres externo).
POSTGRES_USER=danzeroum
POSTGRES_PASSWORD=danzeroum
POSTGRES_DB=oportunidades

# Parâmetros de coleta
# Fontes ativas (CSV): pncp, comprasgov, comprassp, prefsp.
# Default só pncp. As demais existem e são testadas, mas dependem de confirmação:
#  - comprasgov: endpoint da API de Dados Abertos.
#  - comprassp / prefsp: SCRAPING — seletores CSS marcados como "a confirmar"
#    (ajustar em adapters/scraper.py na 1ª execução real com acesso à rede).
TRACKER_SOURCES=pncp
TRACKER_UF=SP
# Modalidades do PNCP (CSV): 6=Pregão Eletrônico, 8=Dispensa. Default 6,8.
TRACKER_MODALIDADES=6,8
# Horizonte (dias) p/ o prazo de propostas abertas consultado no PNCP.
TRACKER_PROPOSAL_HORIZON_DAYS=365
# Palavras-chave (CSV). Vazio = usa o default embutido (perfil de TI da Danzeroum).
TRACKER_KEYWORDS=
# Scorer: 'heuristic' (default, sem LLM). Provedores de LLM virão em rodada futura.
TRACKER_SCORER=heuristic
# Frequência do loop (horas). 24 = uma coleta por dia (poucos acessos).
COLLECT_INTERVAL_HOURS=24
# Aderência mínima (0-1) para gerar alerta.
TRACKER_MIN_FIT=0.4

# Calibração de endpoint/paginação (avançado). Vazio = default do app.
# Preencha se a API mudar de caminho/host na 1ª execução real.
PNCP_BASE_URL=
COMPRAS_GOV_BASE_URL=
# TRACKER_PAGE_SIZE=50
# TRACKER_MAX_PAGES=5
# TRACKER_REQUEST_TIMEOUT=30

# Alertas por e-mail (OPCIONAL). Sem SMTP_HOST + MAIL_TO, vira no-op (não envia).
# Reusa as mesmas variáveis do site (smtp.hostinger.com etc.).
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Rastreador Danzeroum
MAIL_TO=
