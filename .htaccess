# ============================================================
# Danzeroum — config Apache / LiteSpeed (Hostinger lê .htaccess)
# Em nginx este arquivo é ignorado (use deploy/nginx-danzeroum.conf).
# ============================================================

# Página 404 personalizada
ErrorDocument 404 /404.html

# Sem listagem de diretórios
Options -Indexes

# Força HTTPS (descomente depois que o SSL estiver ativo)
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bloqueia arquivos sensíveis (exemplos de config, git, etc.)
<FilesMatch "(^\.|\.example\.php$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
